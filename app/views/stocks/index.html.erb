<main class="app-shell">
  <header class="app-header">
    <div>
      <p class="eyebrow">LOHAS market analysis</p>
      <h1>Stock Stave</h1>
      <p class="subtitle">Trend, channel, and signal analysis across China’s major exchanges.</p>
    </div>
    <nav class="market-tabs" aria-label="Stock market">
      <%= market_navigation(@area) %>
    </nav>
  </header>

  <section class="toolbar" aria-label="Stock search">
    <%= form_tag(stocks_by_area_path(@area), method: "get", class: "search-form") do %>
      <div class="search-copy">
        <%= label_tag(:stock, "Find a stock") %>
        <span>Search by full code or a partial symbol</span>
      </div>
      <div class="search-controls">
        <%= text_field_tag(:stock, @stock, placeholder: "e.g. #{@area}000001", maxlength: 8, autocomplete: "off") %>
        <%= submit_tag("Search", class: "button button-primary") %>
      </div>
    <% end %>
  </section>

  <% unless @stock %>
    <section class="buy-panel" aria-labelledby="buy-candidates-title">
      <% recency = data_recency(@stavs_date) %>
      <div class="buy-heading">
        <div>
          <p class="eyebrow">Strongest model agreement</p>
          <h2 id="buy-candidates-title">Buy candidates</h2>
          <p>Current buy-family signals ranked by agreement, trend direction, and channel position. The score measures technical agreement—not the probability of profit.</p>
        </div>
        <div class="model-status">
          <span class="data-status data-status-<%= recency[:tone] %>"><%= recency[:label] %></span>
          <span class="model-date">Model date <strong><%= @stavs_date || "Unavailable" %></strong></span>
          <% if @refresh_status[:state] == "succeeded" %>
            <% refresh_date = refresh_finished_date(@refresh_status[:finished_at]) %>
            <% duration = refresh_duration(@refresh_status) %>
            <span class="refresh-status">Daily refresh verified<%= " #{refresh_date}" if refresh_date %><%= " in #{duration}" if duration %></span>
          <% elsif @refresh_status[:state] == "running" %>
            <span class="refresh-status is-running">Daily refresh is running</span>
          <% elsif @refresh_status[:state] == "failed" %>
            <span class="refresh-status is-failed">Last daily refresh failed</span>
          <% end %>
          <% if @refresh_schedule[:enabled] && @refresh_schedule[:time].present? %>
            <span class="refresh-schedule">Automatic refresh daily at <strong><%= @refresh_schedule[:time] %></strong></span>
          <% end %>
        </div>
      </div>

      <% if @buy_candidates.any? %>
        <div class="buy-grid">
          <% @buy_candidates.each do |candidate| %>
            <article class="buy-card">
              <div class="buy-card-top">
                <strong><%= candidate.stock.upcase %></strong>
                <div class="candidate-labels">
                  <span class="candidate-history candidate-history-<%= candidate.history_state.parameterize %>"><%= candidate.history_state %></span>
                  <span><%= candidate.years %> + <%= candidate.lohas %></span>
                </div>
              </div>
              <div class="candidate-score-row">
                <p class="candidate-price"><small>Dataset price</small><%= formatted_number(candidate.price) %></p>
                <p class="candidate-score"><strong><%= candidate.score %></strong><small>/100 agreement · <%= candidate.confidence %></small></p>
              </div>
              <p class="candidate-reason"><%= candidate.reasons.first %></p>
              <p class="candidate-invalidation">Recheck if the signal changes to wait or sell.</p>
              <details class="candidate-details">
                <summary>Why this score?</summary>
                <ul>
                  <% candidate.reasons.each do |reason| %>
                    <li><%= reason %></li>
                  <% end %>
                </ul>
              </details>
              <%= link_to "Open analysis →", stock_analysis_path(candidate.stock, area: @area), class: "candidate-open" %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="no-candidates">No strongest-agreement candidates in this market today. Do not force a trade.</p>
      <% end %>
      <p class="risk-note">Agreement score ≠ expected return. Model shortlist only—not a guarantee or personalized financial advice. <%= link_to "View signal history →", signal_history_path(area: @area) %></p>
    </section>
  <% end %>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <p class="eyebrow"><%= @area.upcase %> market</p>
        <h2>Current signals</h2>
      </div>
      <div class="panel-meta">
        <p class="as-of">Data date <strong><%= @stavs_date || "Unavailable" %></strong></p>
        <%= link_to "Open signal guide →", signal_guide_path(area: @area), class: "guide-link" %>
      </div>
    </div>

    <% unless @stock %>
      <nav class="signal-filters" aria-label="Filter signals">
        <% { "all" => "All", "buy" => "Buy agreement", "sell" => "Sell alert", "watch" => "Watch" }.each do |value, label| %>
          <%= link_to label, stocks_by_area_path(@area, signal: value), class: ["signal-filter", ("is-active" if @signal_filter == value)], aria: { current: ("page" if @signal_filter == value) } %>
        <% end %>
      </nav>
    <% end %>

    <% if @stocks_stavs.any? %>
      <p class="mobile-table-note">Tap a stock for price, trend, channel, and chart details.</p>
      <div class="table-scroll">
        <table class="stock-table">
          <thead>
            <tr>
              <th>Stock</th>
              <th>Year signal</th>
              <th>LOHAS signal</th>
              <th class="metric-column">Long trend</th>
              <th class="metric-column">1-year trend</th>
              <th class="metric-column">Price</th>
              <th class="metric-column">1Y channel</th>
              <th class="metric-column">1Y stave</th>
              <th class="metric-column">3.5Y channel</th>
              <th class="metric-column">3.5Y stave</th>
            </tr>
          </thead>
          <tbody>
            <% @stocks_stavs.each do |stock| %>
              <% historical = stock.date.present? && @stavs_date.present? && stock.date < @stavs_date %>
              <tr class="<%= "is-historical" if historical %>">
                <td class="stock-code">
                  <%= link_to stock.stock.upcase, stock_analysis_path(stock.stock, area: @area) %>
                  <% if historical %>
                    <span class="historical-label">Historical</span>
                    <span class="historical-date">Ended <%= stock.date %></span>
                  <% end %>
                </td>
                <td class="signal-cell"><%= linked_signal_badge(stock.years) %></td>
                <td class="signal-cell"><%= linked_signal_badge(stock.lohas) %></td>
                <td class="metric-column"><%= formatted_number(stock.loha) %></td>
                <td class="metric-column"><%= formatted_number(stock.year) %></td>
                <td class="price metric-column"><%= formatted_number(stock.price) %></td>
                <td class="metric-column"><%= stock.boll1 || "—" %></td>
                <td class="metric-column"><%= stock.stav1 || "—" %></td>
                <td class="metric-column"><%= stock.boll3 || "—" %></td>
                <td class="metric-column"><%= stock.stav3 || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <h3><%= @stock ? "No matching signals" : "No signals in this group" %></h3>
        <p><%= @stock ? "Try another stock code or clear the search to see all current results." : "Choose another filter or wait for the next daily refresh." %></p>
        <%= link_to(@stock ? "Clear search" : "Show all", stocks_by_area_path(@area), class: "button button-secondary") %>
      </div>
    <% end %>
  </section>
</main>
