<main class="app-shell">
  <header class="app-header">
    <div>
      <p class="eyebrow">LOHAS market analysis</p>
      <h1>Stock Stave</h1>
      <p class="subtitle">Trend, channel, and signal analysis across China’s major exchanges.</p>
    </div>
    <nav class="market-tabs" aria-label="Stock market">
      <%= market_navigation(@area) %>
    </nav>
  </header>

  <section class="toolbar" aria-label="Stock search">
    <%= form_tag(stocks_by_area_path(@area), method: "get", class: "search-form") do %>
      <div class="search-copy">
        <%= label_tag(:stock, "Find a stock") %>
        <span>Search by full code or a partial symbol</span>
      </div>
      <div class="search-controls">
        <%= text_field_tag(:stock, @stock, placeholder: "e.g. #{@area}000001", maxlength: 8, autocomplete: "off") %>
        <%= submit_tag("Search", class: "button button-primary") %>
      </div>
    <% end %>
  </section>

  <% unless @stock %>
    <section class="buy-panel" aria-labelledby="buy-candidates-title">
      <% recency = data_recency(@stavs_date) %>
      <div class="buy-heading">
        <div>
          <p class="eyebrow">Strongest model agreement</p>
          <h2 id="buy-candidates-title">Buy candidates</h2>
          <p>Current buy-family signals ranked by agreement, trend direction, and channel position. The score measures technical agreement—not the probability of profit.</p>
        </div>
        <div class="model-status">
          <span class="data-status data-status-<%= recency[:tone] %>"><%= recency[:label] %></span>
          <span class="model-date">Model date <strong><%= @stavs_date || "Unavailable" %></strong></span>
        </div>
      </div>

      <% if @buy_candidates.any? %>
        <div class="buy-grid">
          <% @buy_candidates.each do |candidate| %>
            <%= link_to stock_analysis_path(candidate.stock, area: @area), class: "buy-card" do %>
              <div class="buy-card-top">
                <strong><%= candidate.stock.upcase %></strong>
                <span><%= candidate.years %> + <%= candidate.lohas %></span>
              </div>
              <div class="candidate-score-row">
                <p class="candidate-price"><small>Dataset price</small><%= formatted_number(candidate.price) %></p>
                <p class="candidate-score"><strong><%= candidate.score %></strong><small>/100 agreement · <%= candidate.confidence %></small></p>
              </div>
              <p class="candidate-reason"><%= candidate.reasons.first %></p>
              <p class="candidate-invalidation">Recheck if the signal changes to wait or sell.</p>
              <details class="candidate-details">
                <summary>Why this score?</summary>
                <ul>
                  <% candidate.reasons.each do |reason| %>
                    <li><%= reason %></li>
                  <% end %>
                </ul>
              </details>
              <span class="candidate-open">Open analysis →</span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="no-candidates">No strongest-agreement candidates in this market today. Do not force a trade.</p>
      <% end %>
      <p class="risk-note">Agreement score ≠ expected return. Model shortlist only—not a guarantee or personalized financial advice.</p>
    </section>
  <% end %>

  <section class="panel">
    <div class="panel-heading">
      <div>
        <p class="eyebrow"><%= @area.upcase %> market</p>
        <h2>Current signals</h2>
      </div>
      <div class="panel-meta">
        <p class="as-of">Data date <strong><%= @stavs_date || "Unavailable" %></strong></p>
        <%= link_to "Open signal guide →", signal_guide_path(area: @area), class: "guide-link" %>
      </div>
    </div>

    <% if @stocks_stavs.any? %>
      <div class="table-scroll">
        <table class="stock-table">
          <thead>
            <tr>
              <th>Stock</th>
              <th>Year signal</th>
              <th>LOHAS signal</th>
              <th>Long trend</th>
              <th>1-year trend</th>
              <th>Price</th>
              <th>1Y channel</th>
              <th>1Y stave</th>
              <th>3.5Y channel</th>
              <th>3.5Y stave</th>
            </tr>
          </thead>
          <tbody>
            <% @stocks_stavs.each do |stock| %>
              <% historical = stock.date.present? && @stavs_date.present? && stock.date < @stavs_date %>
              <tr class="<%= "is-historical" if historical %>">
                <td class="stock-code">
                  <%= link_to stock.stock.upcase, stock_analysis_path(stock.stock, area: @area) %>
                  <% if historical %>
                    <span class="historical-label">Historical</span>
                    <span class="historical-date">Ended <%= stock.date %></span>
                  <% end %>
                </td>
                <td class="signal-cell"><%= linked_signal_badge(stock.years) %></td>
                <td class="signal-cell"><%= linked_signal_badge(stock.lohas) %></td>
                <td><%= formatted_number(stock.loha) %></td>
                <td><%= formatted_number(stock.year) %></td>
                <td class="price"><%= formatted_number(stock.price) %></td>
                <td><%= stock.boll1 || "—" %></td>
                <td><%= stock.stav1 || "—" %></td>
                <td><%= stock.boll3 || "—" %></td>
                <td><%= stock.stav3 || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <h3>No matching signals</h3>
        <p>Try another stock code or clear the search to see all current results.</p>
        <%= link_to "Clear search", stocks_by_area_path(@area), class: "button button-secondary" %>
      </div>
    <% end %>
  </section>
</main>
