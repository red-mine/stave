<h1 align=center>Stock Stave</h1>

<table align=center border=1 cellspacing=0>

  <tr>
    <td colspan=10 align=center>
        <%= form_tag(stocks_by_area_path(@area), method: "get") do %>
          <%= label_tag(:stock, "Stocks/#{@area.upcase}=") %>
          <%= text_field_tag(:stock) %>
          <%= submit_tag("Stave") %>
        <% end %>
    </td>
  </tr>

  <tr>
    <th>
      Stock/
      <% Stock::AREAS.each_with_index do |area, index| %>
        <%= " / " unless index.zero? %>
        <% if area == @area %>
          <%= area.upcase %>
        <% else %>
          <%= link_to area.upcase, stocks_by_area_path(area) %>
        <% end %>
      <% end %>
    </th>
    <th>Loh</th>
    <th>One</th>
    <th>Price</th>
    <th>b1</th>
    <th>s1</th>
    <th>b3</th>
    <th>s3</th>
    <th>Year</th>
    <th>Loha</th>
  </tr>

  <% @stocks_stavs.each do |stock| %>
  <tr>
    <td>
      <%= link_to stock.stock.upcase, stock_analysis_path(stock.stock, area: @area) %>
    </td>
    <td>
      <%= stock.loha.round(2) %>
    </td>
    <td>
      <%= stock.year.round(2) %>
    </td>
    <td><%= stock.price %></td>
    <td align=right><%= stock.boll1 %></td>
    <td align=right><%= stock.stav1 %></td>
    <td align=right><%= stock.boll3 %></td>
    <td align=right><%= stock.stav3 %></td>
    <td><%= stock.years %></td>
    <td>
      <a href="/stave/stave.png">
        <%= stock.lohas %>
      </a>
    </td>
  </tr>
  <% end %>

</table>

<h4 align=center><%= @stavs_date %></h4>
