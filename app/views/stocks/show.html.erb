<main class="app-shell">
  <header class="detail-header">
    <div>
      <%= link_to "← Back to #{@area.upcase} signals", stocks_by_area_path(@area, anchor: @return_anchor), class: "back-link" %>
      <p class="eyebrow">Stock analysis</p>
      <h1><%= @stock.upcase %></h1>
    </div>
    <nav class="market-tabs" aria-label="Stock market">
      <%= market_navigation(@area) %>
    </nav>
  </header>

  <section class="data-freshness <%= "is-historical" if @historical_data %>" aria-label="Data freshness">
    <% if @historical_data %>
      <div>
        <p class="eyebrow">Historical data</p>
        <p>This stock's data ends on <strong><%= @stock_date %></strong>.</p>
      </div>
      <p class="freshness-context"><%= @area.upcase %> market data continues through <strong><%= @market_date %></strong>.</p>
    <% else %>
      <div>
        <p class="eyebrow">Data current through</p>
        <p><strong><%= @stock_date || "Unavailable" %></strong></p>
      </div>
    <% end %>
  </section>

  <% if @trend_health %>
    <section class="trend-health" aria-labelledby="trend-health-title">
      <div>
        <p class="eyebrow">Trend strength</p>
        <h2 id="trend-health-title">Regression slope health</h2>
        <p class="trend-note">The LOHAS strategy is designed for confirmed uptrends. Weak or negative trends lower the expected win rate.</p>
      </div>
      <div class="trend-horizons">
        <div class="trend-horizon trend-<%= @trend_health[:loha_status] %>">
          <small>LOHAS (3.5 yr)</small>
          <strong><%= number_with_precision(@trend_health[:loha_slope], precision: 4) %></strong>
          <span class="trend-label"><%= trend_status_label(@trend_health[:loha_status]) %></span>
        </div>
        <div class="trend-horizon trend-<%= @trend_health[:year_status] %>">
          <small>Year (1 yr)</small>
          <strong><%= number_with_precision(@trend_health[:year_slope], precision: 4) %></strong>
          <span class="trend-label"><%= trend_status_label(@trend_health[:year_status]) %></span>
        </div>
      </div>
      <% if @trend_health[:loha_status] == "downtrend" || @trend_health[:year_status] == "downtrend" %>
        <p class="trend-warning">⚠️ At least one horizon shows a downtrend. The mean-reversion assumption may not hold.</p>
      <% elsif @trend_health[:loha_status] == "weak_uptrend" || @trend_health[:year_status] == "weak_uptrend" || @trend_health[:loha_status] == "flat" || @trend_health[:year_status] == "flat" %>
        <p class="trend-caution">⚠️ Trend strength is weak or flat. Consider waiting for a stronger uptrend confirmation.</p>
      <% end %>
    </section>
  <% end %>

  <% if @signal_timeline.any? %>
    <% current_signal = @signal_timeline.first %>
    <section class="current-decision decision-<%= @current_decision %>" aria-labelledby="current-decision-title">
      <div>
        <p class="eyebrow">Latest recorded decision</p>
        <h2 id="current-decision-title"><%= Stock::SignalFamily.label(@current_decision) %></h2>
        <p class="decision-reason"><%= Stock::SignalFamily.explanation(@current_decision) %> This is model context, not personalized financial advice.</p>
        <p>Recorded <strong><%= current_signal.date %></strong> at dataset price <strong><%= formatted_number(current_signal.price) %></strong>.</p>
        <%= link_to "Understand these signals →", signal_guide_path(area: @area), class: "guide-link decision-guide" %>
      </div>
      <div class="decision-signals">
        <div><small>Year</small><%= linked_signal_badge(current_signal.year_signal) %></div>
        <div><small>LOHAS</small><%= linked_signal_badge(current_signal.lohas_signal) %></div>
      </div>
    </section>
  <% end %>

  <section class="signal-timeline" aria-labelledby="signal-timeline-title">
    <div class="timeline-heading">
      <div>
        <p class="eyebrow">Recorded evidence</p>
        <h2 id="signal-timeline-title">Recent signal history</h2>
      </div>
      <%= link_to "All market history →", signal_history_path(area: @area), class: "guide-link" %>
    </div>

    <% if @signal_timeline.any? %>
      <div class="timeline-list">
        <% @signal_timeline.each do |entry| %>
          <article class="timeline-entry <%= "is-change" if entry.changed %>">
            <div class="timeline-date">
              <strong><%= entry.date %></strong>
              <span><%= entry.changed ? "Signal changed" : "Recorded" %></span>
            </div>
            <div class="timeline-signals">
              <div><small>Year</small><%= linked_signal_badge(entry.year_signal) %></div>
              <div><small>LOHAS</small><%= linked_signal_badge(entry.lohas_signal) %></div>
            </div>
            <p><small>Price</small><strong><%= formatted_number(entry.price) %></strong></p>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="timeline-empty">History starts after the next successful daily refresh. No past signal is reconstructed from future data.</p>
    <% end %>
  </section>

  <p class="chart-sampling-note"><strong>Why can the last plotted date be earlier?</strong> Recent charts use one point per month and long-horizon charts use one point per quarter. The data-current date above is the authoritative final trading date.</p>

  <div class="chart-grid">
    <section class="chart-card">
      <div class="chart-heading">
        <div><p class="eyebrow">Long horizon</p><h2>LOHAS stave</h2></div>
        <span class="chart-period"><strong>3.5 years · quarterly</strong><small><%= chart_date_range(@stave_lohas) %></small></span>
      </div>
      <%= line_chart @stave_lohas.map { |series| { name: series[:name], data: series[:data] } }, height: "340px", points: false %>
    </section>

    <section class="chart-card">
      <div class="chart-heading">
        <div><p class="eyebrow">Recent horizon</p><h2>Year stave</h2></div>
        <span class="chart-period"><strong>1 year · monthly</strong><small><%= chart_date_range(@stave_years) %></small></span>
      </div>
      <%= line_chart @stave_years.map { |series| { name: series[:name], data: series[:data] } }, height: "340px", points: false %>
    </section>

    <section class="chart-card">
      <div class="chart-heading">
        <div><p class="eyebrow">Long horizon</p><h2>LOHAS channel</h2></div>
        <span class="chart-period"><strong>3.5 years · quarterly</strong><small><%= chart_date_range(@bolls_lohas) %></small></span>
      </div>
      <%= line_chart @bolls_lohas.map { |series| { name: series[:name], data: series[:data] } }, height: "340px", points: false %>
    </section>

    <section class="chart-card">
      <div class="chart-heading">
        <div><p class="eyebrow">Recent horizon</p><h2>Year channel</h2></div>
        <span class="chart-period"><strong>1 year · monthly</strong><small><%= chart_date_range(@bolls_years) %></small></span>
      </div>
      <%= line_chart @bolls_years.map { |series| { name: series[:name], data: series[:data] } }, height: "340px", points: false %>
    </section>
  </div>
</main>
