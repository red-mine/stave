[Unit]
Description=Check and recover the Stock Stave public preview
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/stockstave
Environment="PATH=%h/.rbenv/bin:%h/.rbenv/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/work/stockstave/bin/ensure-public-preview.sh
