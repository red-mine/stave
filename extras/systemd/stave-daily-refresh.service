[Unit]
Description=Stock Stave daily market data refresh
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/lohas-stave
Environment="PATH=%h/.rbenv/bin:%h/.rbenv/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/work/lohas-stave/bin/daily-refresh.sh --source scheduled
